{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voyager",
  "version": "0.1.0",
  "identifier": "com.swmansion.voyager",
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "deb"],
    "resources": {
      "target/rel": "rel"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
