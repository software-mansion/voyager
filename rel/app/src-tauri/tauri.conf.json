{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voyager",
  "version": "0.1.0",
  "identifier": "com.swmansion.voyager",
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage"],
    "resources": {
      "target/rel": "rel"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/rel": "target/rel"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
