<!DOCTYPE html>
<html lang="en">
  <head>
    {Application.get_env(:live_debugger, :live_debugger_tags)}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="env" content={Application.get_env(:voyager, :env)} />
    <link
      rel="preload"
      href={~p"/fonts/dm-sans-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/jetbrains-mono-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <.live_title default="Voyager" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href="/assets/css/favicon.svg" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const KEY = "phx:theme";
        const media = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        let osTheme = media();

        const preference = () => {
          const value = localStorage.getItem(KEY);
          return value === "light" || value === "dark" ? value : "system";
        };

        const resolve = () => {
          const pref = preference();
          document.documentElement.setAttribute(
            "data-theme",
            pref === "system" ? osTheme : pref
          );
        };

        const setOs = (theme) => {
          if (theme !== "dark" && theme !== "light") return;
          osTheme = theme;
          resolve();
        };

        resolve();

        window.addEventListener("storage", (e) => {
          if (e.key === KEY) resolve();
        });

        window.addEventListener("phx:set-theme", (e) => {
          const theme = e.target.dataset.phxTheme;
          if (theme === "system") localStorage.removeItem(KEY);
          else if (theme === "light" || theme === "dark") localStorage.setItem(KEY, theme);
          else return;
          resolve();
        });

        const tauri = window.__TAURI__;
        if (typeof tauri?.core?.invoke === "function") {
          tauri.core.invoke("os_theme").then(setOs).catch(() => {});
          if (typeof tauri.event?.listen === "function") {
            let unlisten;
            tauri.event
              .listen("os-theme-changed", (event) => setOs(event.payload))
              .then((fn) => {
                unlisten = fn;
              });
            window.addEventListener("pagehide", () => {
              if (typeof unlisten === "function") unlisten();
            });
          }
        } else {
          window
            .matchMedia("(prefers-color-scheme: dark)")
            .addEventListener("change", (e) => {
              setOs(e.matches ? "dark" : "light");
            });
        }
      })();
    </script>
  </head>
  <body>
    {@inner_content}
    <%!-- Global target for teleported tooltip popovers (see <.help_tooltip>) --%>
    <div id="tooltip-portal-root"></div>
  </body>
</html>
