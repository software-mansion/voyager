<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    {Application.get_env(:live_debugger, :live_debugger_tags)}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="env" content={Application.get_env(:voyager, :env)} />
    <link
      rel="preload"
      href={~p"/fonts/dm-sans-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/jetbrains-mono-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <.live_title default="Voyager" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href="/assets/css/favicon.svg" />
    <script>
      (() => {
        const KEY = "phx:theme";
        const OS_KEY = "voyager:os-theme";
        const media = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const isTheme = (theme) => theme === "dark" || theme === "light";
        const storedOs = () => {
          try {
            return sessionStorage.getItem(OS_KEY);
          } catch (_error) {
            return null;
          }
        };

        const hint = window.__VOYAGER_OS_THEME__;
        const stored = storedOs();
        let osTheme = isTheme(hint) ? hint : isTheme(stored) ? stored : media();
        let nativeOs = isTheme(hint) || isTheme(stored);

        const preference = () => {
          const value = localStorage.getItem(KEY);
          return value === "light" || value === "dark" ? value : "system";
        };

        const resolve = () => {
          const pref = preference();
          const theme = pref === "system" ? osTheme : pref;
          document.documentElement.setAttribute("data-theme", theme);
          const invoke = window.__TAURI__?.core?.invoke;
          if (typeof invoke === "function" && isTheme(theme)) {
            invoke("set_surface", { theme }).catch(() => {});
          }
        };

        const setOs = (theme) => {
          if (!isTheme(theme)) return;
          osTheme = theme;
          try {
            sessionStorage.setItem(OS_KEY, theme);
          } catch (_error) {}
          resolve();
        };

        const setOsFromNative = (theme) => {
          if (!isTheme(theme)) return;
          nativeOs = true;
          setOs(theme);
        };

        resolve();

        window.addEventListener("storage", (e) => {
          if (e.key === KEY) resolve();
        });

        window.addEventListener("phx:set-theme", (e) => {
          const theme = e.target.dataset.phxTheme;
          if (theme === "system") localStorage.removeItem(KEY);
          else if (theme === "light" || theme === "dark") localStorage.setItem(KEY, theme);
          else return;
          resolve();
        });

        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (nativeOs) return;
            setOs(e.matches ? "dark" : "light");
          });

        const tauri = window.__TAURI__;
        if (typeof tauri?.core?.invoke === "function") {
          const refreshOs = () =>
            tauri.core.invoke("os_theme").then(setOsFromNative).catch(() => {});
          refreshOs();
          document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible") refreshOs();
          });
          if (typeof tauri.event?.listen === "function") {
            const listenPromise = tauri.event.listen("os-theme-changed", (event) =>
              setOsFromNative(event.payload)
            );
            window.addEventListener("pagehide", () => {
              listenPromise.then((unlisten) => unlisten());
            });
          }
        }
      })();
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
    <%!-- Global target for teleported tooltip popovers (see <.help_tooltip>) --%>
    <div id="tooltip-portal-root"></div>
  </body>
</html>
