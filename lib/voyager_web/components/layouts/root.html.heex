<!DOCTYPE html>
<html lang="en">
  <head>
    {Application.get_env(:live_debugger, :live_debugger_tags)}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="env" content={Application.get_env(:voyager, :env)} />
    <link
      rel="preload"
      href={~p"/fonts/dm-sans-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/jetbrains-mono-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <.live_title default="Voyager" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href="/assets/css/favicon.svg" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const THEME_KEY = "phx:theme";
        // Survives full document reloads within the webview (live_session hops).
        // The Tauri init script's create-time detect() is otherwise re-injected
        // stale on every navigation after the OS theme changes.
        const OS_THEME_KEY = "voyager:os-theme";

        const mediaTheme = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const isTheme = (theme) => theme === "dark" || theme === "light";

        const rememberOsTheme = (theme) => {
          if (!isTheme(theme)) return;
          window.__VOYAGER_OS_THEME__ = theme;
          try {
            sessionStorage.setItem(OS_THEME_KEY, theme);
          } catch (_error) {}
        };

        // Prefer remembered OS theme, then Tauri init hint, then matchMedia.
        const osThemeHint = () => {
          try {
            const remembered = sessionStorage.getItem(OS_THEME_KEY);
            if (isTheme(remembered)) return remembered;
          } catch (_error) {}
          const hint = window.__VOYAGER_OS_THEME__;
          return isTheme(hint) ? hint : null;
        };

        const getSystemTheme = () => osThemeHint() || mediaTheme();

        const applyTheme = (theme) => {
          document.documentElement.setAttribute("data-theme", theme);
        };

        const setTheme = (theme) => {
          localStorage.setItem(THEME_KEY, theme);
          applyTheme(theme);
        };

        // Prefer the OS hint when present (Tauri first paint / onThemeChanged).
        // Falls back to prefers-color-scheme in the browser, where the hint is absent.
        // Do not write sessionStorage here — a create-time init hint can be stale
        // after an OS change; only onThemeChanged should remember the live value.
        const syncTheme = () => {
          applyTheme(localStorage.getItem(THEME_KEY) || getSystemTheme());
        };

        // Once Tauri onThemeChanged is attached, ignore matchMedia — the webview's
        // prefers-color-scheme can disagree with the real OS appearance and would
        // overwrite the correct theme.
        let trustOsThemeListener = false;

        syncTheme();

        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", () => {
            if (trustOsThemeListener || localStorage.getItem(THEME_KEY)) return;
            syncTheme();
          });

        window.addEventListener("storage", (e) => {
          if (e.key === THEME_KEY) syncTheme();
        });

        window.addEventListener("phx:set-theme", (e) => {
          const theme = e.target.dataset.phxTheme;
          if (theme === "system") {
            localStorage.removeItem(THEME_KEY);
            syncTheme();
            refreshOsThemeFromTauri();
          } else {
            setTheme(theme);
          }
        });

        const getTauriWindow = () =>
          window.__TAURI__?.window?.getCurrentWindow?.() ?? null;

        const invokeOsTheme = async () => {
          const invoke = window.__TAURI__?.core?.invoke;
          if (typeof invoke !== "function") return null;
          try {
            const theme = await invoke("os_theme");
            return isTheme(theme) ? theme : null;
          } catch (_error) {
            return null;
          }
        };

        // Re-detect OS appearance after full reloads (live_session navigations).
        // The init script value is fixed at window create and goes stale.
        const refreshOsThemeFromTauri = async () => {
          const theme = await invokeOsTheme();
          if (!theme) return;
          rememberOsTheme(theme);
          if (!localStorage.getItem(THEME_KEY)) applyTheme(theme);
        };

        const listenForOsThemeChanges = async () => {
          const win = getTauriWindow();
          if (!win?.onThemeChanged) return false;

          try {
            await win.onThemeChanged(({ payload }) => {
              if (!isTheme(payload)) return;
              // Always keep OS appearance fresh so Auto can use it later,
              // even while Light/Dark is locked in localStorage.
              rememberOsTheme(payload);
              if (!localStorage.getItem(THEME_KEY)) applyTheme(payload);
            });
            trustOsThemeListener = true;
            return true;
          } catch (_error) {
            return false;
          }
        };

        if (window.__TAURI_INTERNALS__) {
          refreshOsThemeFromTauri();

          let attempts = 0;
          const tryListen = async () => {
            if (await listenForOsThemeChanges()) return;
            attempts += 1;
            if (attempts < 20) setTimeout(tryListen, 50);
          };
          tryListen();
        }
      })();
    </script>
  </head>
  <body>
    {@inner_content}
    <%!-- Global target for teleported tooltip popovers (see <.help_tooltip>) --%>
    <div id="tooltip-portal-root"></div>
  </body>
</html>
