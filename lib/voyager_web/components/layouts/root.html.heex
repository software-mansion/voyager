<!DOCTYPE html>
<html lang="en">
  <head>
    {Application.get_env(:live_debugger, :live_debugger_tags)}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="preload" href={~p"/fonts/dm-sans-latin-wght-normal.woff2"} as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href={~p"/fonts/jetbrains-mono-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <.live_title default="Voyager" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const getSystemTheme = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const applyTheme = (theme) => {
          document.documentElement.setAttribute("data-theme", theme);
        };

        const setTheme = (theme) => {
          localStorage.setItem("phx:theme", theme);
          applyTheme(theme);
        };

        const syncTheme = () => {
          applyTheme(localStorage.getItem("phx:theme") || getSystemTheme());
        };

        syncTheme();

        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", () => {
            if (!localStorage.getItem("phx:theme")) syncTheme();
          });

        window.addEventListener("storage", (e) => {
          if (e.key === "phx:theme") syncTheme();
        });

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
