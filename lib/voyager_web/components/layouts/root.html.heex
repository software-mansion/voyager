<!DOCTYPE html>
<html lang="en">
  <head>
    {Application.get_env(:live_debugger, :live_debugger_tags)}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="env" content={Application.get_env(:voyager, :env)} />
    <link
      rel="preload"
      href={~p"/fonts/dm-sans-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/jetbrains-mono-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <.live_title default="Voyager" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href="/assets/css/favicon.svg" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const THEME_KEY = "phx:theme";

        const mediaTheme = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const isTheme = (theme) => theme === "dark" || theme === "light";

        // Injected by Tauri via dark-light before page scripts run. Prefer this
        // over prefers-color-scheme in the desktop webview, which can disagree
        // with the real OS appearance.
        const osThemeHint = () => {
          const hint = window.__VOYAGER_OS_THEME__;
          return isTheme(hint) ? hint : null;
        };

        const getSystemTheme = () => osThemeHint() || mediaTheme();

        const applyTheme = (theme) => {
          document.documentElement.setAttribute("data-theme", theme);
        };

        const setTheme = (theme) => {
          localStorage.setItem(THEME_KEY, theme);
          applyTheme(theme);
        };

        // Runtime Auto sync must not prefer the launch-time OS hint — it goes
        // stale after OS appearance changes and can overwrite onThemeChanged.
        const syncTheme = () => {
          applyTheme(localStorage.getItem(THEME_KEY) || mediaTheme());
        };

        // First paint: prefer dark-light hint (webview prefers-color-scheme can disagree).
        applyTheme(localStorage.getItem(THEME_KEY) || getSystemTheme());

        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", () => {
            if (!localStorage.getItem(THEME_KEY)) syncTheme();
          });

        window.addEventListener("storage", (e) => {
          if (e.key === THEME_KEY) syncTheme();
        });

        window.addEventListener("phx:set-theme", (e) => {
          const theme = e.target.dataset.phxTheme;
          if (theme === "system") {
            localStorage.removeItem(THEME_KEY);
            syncTheme();
          } else {
            setTheme(theme);
          }
        });

        const getTauriWindow = () => {
          try {
            return window.__TAURI__?.window?.getCurrentWindow?.() ?? null;
          } catch (_error) {
            return null;
          }
        };

        const listenForOsThemeChanges = async () => {
          const win = getTauriWindow();
          if (!win?.onThemeChanged) return false;

          try {
            await win.onThemeChanged(({ payload }) => {
              if (localStorage.getItem(THEME_KEY)) return;
              if (isTheme(payload)) {
                window.__VOYAGER_OS_THEME__ = payload;
                applyTheme(payload);
              } else {
                syncTheme();
              }
            });
            return true;
          } catch (_error) {
            return false;
          }
        };

        if (window.__TAURI_INTERNALS__) {
          let attempts = 0;
          const tryListen = async () => {
            if (await listenForOsThemeChanges()) return;
            attempts += 1;
            if (attempts < 20) setTimeout(tryListen, 50);
          };
          tryListen();
        }
      })();
    </script>
  </head>
  <body>
    {@inner_content}
    <%!-- Global target for teleported tooltip popovers (see <.help_tooltip>) --%>
    <div id="tooltip-portal-root"></div>
  </body>
</html>
